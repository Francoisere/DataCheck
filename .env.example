# Configuración de variables de entorno para DataCheck.cl
ENVIRONMENT=production
PORT=8000
DATABASE_URL=postgresql+asyncpg://postgres:postgres_pass@localhost:5432/privacy_audit
SCAN_TIMEOUT_SECONDS=25.0
SCAN_PAGE_TIMEOUT_MS=15000
SCHEDULER_CHECK_INTERVAL_SECONDS=30

# ==============================================================================
# CONFIGURACIÓN DE CORREO SALIENTE (SMTP)
# ==============================================================================

# OPCIÓN 1 (Por defecto en Docker): Mailpit local con buzón web en http://localhost:8025
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_FROM_EMAIL=alertas@datacheck.cl
# SMTP_TLS=false

# OPCIÓN 2: Envío real a buzón Gmail (ej. bvidal603@gmail.com)
# Requiere activar 2FA y generar una "Contraseña de aplicación" (16 letras) en:
# https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=bvidal603@gmail.com
# SMTP_PASSWORD=tu_contrasena_de_aplicacion
# SMTP_FROM_EMAIL=bvidal603@gmail.com
# SMTP_TLS=false

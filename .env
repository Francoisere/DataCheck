# Configuración por defecto: Servidor SMTP simulado (Mailpit)
# Todos los correos enviados se pueden ver y descargar en: http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alertas@datacheck.cl
SMTP_TLS=false

# ==============================================================================
# Si deseas que los correos salgan a tu buzón REAL de Gmail, comenta lo de arriba
